% -*- Mode:TeX -*-
%
% Template for front/signature.tex. Rendered by scripts/render_metadata.py
% from thesis.json (degree_level, committee[]). DO NOT edit signature.tex
% directly — edit thesis.json and rerun the script. (On Overleaf, edit
% front/signature.tex: one \signature{role}{name} line per member.)
%
% Layout follows Appendix 3 of the Yonsei 2026 spec: title / "This
% certifies that the dissertation of NAME is approved." / one signature
% line + "Committee Chair | Prof. Name" row per member (5 for doctoral,
% 3 for master) / department, Graduate School, Yonsei University, date.
% Titles must all be "Prof." or all "Dr." (or all empty for digital
% approval through the Yonsei Portal). The renderer enforces this.
%
% Once the page is signed in print, scan it as `front/signed.pdf` and
% swap the \input/\includepdf lines in `front/cover.tex.in`.

\begin{signpage}
\signpagehead
@@COMMITTEE_BLOCKS@@
\signpagefoot
\end{signpage}
